#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════╗
# ║  estudio — Comando de status do EstudioHC                   ║
# ║  Uso: estudio                                               ║
# ║  Instalar: sudo cp estudio /usr/local/bin/estudio           ║
# ╚══════════════════════════════════════════════════════════════╝

SERVIDOR_API="http://100.64.117.78:8585/api"
ESTACAO=$(hostname)
TIMESTAMP=$(date '+%Y-%m-%d %H:%M')

# Cores
VERDE='\033[0;32m'
AMARELO='\033[1;33m'
VERMELHO='\033[0;31m'
AZUL='\033[0;34m'
CIANO='\033[0;36m'
NEGRITO='\033[1m'
RESET='\033[0m'

echo ""
echo -e "${NEGRITO}${AZUL}╔══════════════════════════════════════════════════════╗${RESET}"
echo -e "${NEGRITO}${AZUL}║         🎙️  EstudioHC — Central de Comando           ║${RESET}"
echo -e "${NEGRITO}${AZUL}╚══════════════════════════════════════════════════════╝${RESET}"
echo -e "  ${CIANO}Estação:${RESET} ${NEGRITO}${ESTACAO}${RESET}   ${CIANO}Data:${RESET} ${TIMESTAMP}"
echo ""

# ── 1. Verificar serviços LOCAIS ─────────────────────────────────
echo -e "${NEGRITO}── Serviços Locais ──────────────────────────────────────${RESET}"

check_service() {
    local nome="$1"
    local servico="$2"
    if systemctl is-active --quiet "$servico" 2>/dev/null; then
        echo -e "  ${VERDE}●${RESET} ${nome}"
    else
        echo -e "  ${VERMELHO}○${RESET} ${nome} ${VERMELHO}(inativo)${RESET}"
    fi
}

check_port() {
    local nome="$1"
    local porta="$2"
    if curl -s --max-time 1 "http://localhost:${porta}" > /dev/null 2>&1 || \
       ss -tlnp 2>/dev/null | grep -q ":${porta}"; then
        echo -e "  ${VERDE}●${RESET} ${nome} (porta ${porta})"
    else
        echo -e "  ${AMARELO}○${RESET} ${nome} (porta ${porta} — verificar)"
    fi
}

check_service "KoboldCpp (IA Local)" "koboldcpp"
check_port    "KoboldCpp Web" "11434"

echo ""

# ── 2. Verificar conexão com SERVIDOR CENTRAL ───────────────────
echo -e "${NEGRITO}── Servidor Central (Contabo) ───────────────────────────${RESET}"

# Faz uma única chamada HTTP rápida com timeout curto (1.5 segundos)
CENTRAL_JSON=$(curl -s --max-time 1.5 "${SERVIDOR_API}/status" 2>/dev/null)

if [ -n "$CENTRAL_JSON" ]; then
    echo -e "  ${VERDE}●${RESET} Servidor Contabo (100.64.117.78) — ONLINE via Tailscale"
    
    # Extrai o status da Central e do Hermes da resposta JSON usando python ou bash regex
    # para evitar dependência externa de 'jq'
    HERMES_STATUS=$(echo "$CENTRAL_JSON" | python3 -c "import sys, json; print(json.load(sys.stdin).get('hermes', False))" 2>/dev/null)
    
    echo -e "  ${VERDE}●${RESET} EstudioHC Central API — online (porta 8585)"
    if [ "$HERMES_STATUS" = "True" ]; then
        echo -e "  ${VERDE}●${RESET} Hermes Agent Central — online (OpenRouter)"
    else
        echo -e "  ${AMARELO}○${RESET} Hermes Agent Central — ${AMARELO}desativado ou sem API Key${RESET}"
    fi
else
    echo -e "  ${VERMELHO}○${RESET} Servidor Contabo — INACESSÍVEL (Tailscale offline ou API inativa?)"
fi

echo ""

# ── 3. Tarefas pendentes do servidor ────────────────────────────
echo -e "${NEGRITO}── Próximas Tarefas (do Servidor) ──────────────────────${RESET}"

# Faz outra chamada HTTP rápida para buscar o status em markdown de forma transparente e instantânea
STATUS_MD_JSON=$(curl -s --max-time 1.5 "${SERVIDOR_API}/status_md" 2>/dev/null)
CONTEUDO_MD=$(echo "$STATUS_MD_JSON" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('conteudo', d.get('erro', '')))" 2>/dev/null)

if [ -n "$CONTEUDO_MD" ] && [[ ! "$CONTEUDO_MD" =~ "não encontrado" ]]; then
    # Cache local do status
    mkdir -p "$HOME/.estudio_cache"
    echo "$CONTEUDO_MD" > "$HOME/.estudio_cache/STATUS.md"
    
    # Processa as tarefas pendentes do arquivo markdown usando grep/sed tradicional do Linux
    echo "$CONTEUDO_MD" | grep '\- \[ \]' | head -8 | sed 's/- \[ \]/  ○/g' | while IFS= read -r linha; do
        echo -e "  ${AMARELO}○${RESET}${linha#  ○}"
    done
    
    TOTAL=$(echo "$CONTEUDO_MD" | grep -c '\- \[ \]')
    echo -e "\n  ${CIANO}Total de tarefas pendentes: ${NEGRITO}${TOTAL}${RESET}"
else
    echo -e "  ${AMARELO}⚠ Servidor inacessível — lendo cache local${RESET}"
    if [ -f "$HOME/.estudio_cache/STATUS.md" ]; then
        grep '\- \[ \]' "$HOME/.estudio_cache/STATUS.md" | head -8 | sed 's/- \[ \]/  ○/g' | while IFS= read -r linha; do
            echo -e "  ${AMARELO}○${RESET}${linha#  ○}"
        done
        TOTAL=$(grep -c '\- \[ \]' "$HOME/.estudio_cache/STATUS.md")
        echo -e "\n  ${CIANO}Total de tarefas pendentes: ${NEGRITO}${TOTAL}${RESET}"
    else
        echo "  Sem cache local disponível."
    fi
fi

echo ""

# ── 4. Próximo passo recomendado ─────────────────────────────────
echo -e "${NEGRITO}── Próximo Passo ────────────────────────────────────────${RESET}"
if [ -n "$CONTEUDO_MD" ] && [[ ! "$CONTEUDO_MD" =~ "não encontrado" ]]; then
    PROXIMO=$(echo "$CONTEUDO_MD" | grep '\- \[ \]' | head -1 | sed 's/.*\- \[ \] //')
    if [ -n "$PROXIMO" ]; then
        echo -e "  ${VERDE}▶${RESET} ${PROXIMO}"
    fi
else
    if [ -f "$HOME/.estudio_cache/STATUS.md" ]; then
        PROXIMO=$(grep '\- \[ \]' "$HOME/.estudio_cache/STATUS.md" | head -1 | sed 's/.*\- \[ \] //')
        if [ -n "$PROXIMO" ]; then
            echo -e "  ${VERDE}▶${RESET} ${PROXIMO}"
        fi
    fi
fi

echo ""
echo -e "${AZUL}  Para acessar o Painel Web Central:${RESET}"
echo -e "  ${NEGRITO}http://100.64.117.78:8585${RESET}"
echo -e "${AZUL}  Para ver o plano completo:${RESET}"
echo -e "  ${NEGRITO}estudio --plano${RESET}"
echo ""
echo -e "${NEGRITO}${AZUL}══════════════════════════════════════════════════════${RESET}"
echo ""

# ── Modo --plano ────────────────────────────────────────────────
if [ "${1}" = "--plano" ]; then
    echo ""
    if [ -n "$CONTEUDO_MD" ] && [[ ! "$CONTEUDO_MD" =~ "não encontrado" ]]; then
        echo "$CONTEUDO_MD"
    elif [ -f "$HOME/.estudio_cache/STATUS.md" ]; then
        cat "$HOME/.estudio_cache/STATUS.md"
    else
        echo "Nenhum plano disponível."
    fi
fi
