# ── Core ──
APP_NAME=EstudioHC Central API
DEBUG=false
API_PORT=5050

# ── Database ──
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///${HOME}/Apps/EstudioHC-Memory-Suite/data/estudiohc.db
# PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/estudiohc

# ── CORS ──
CORS_ORIGINS=["*"]

# ── Auth ──
# API key opcional. VAZIO = autenticação desabilitada (modo dev, tudo aberto).
# Configurado = toda rota protegida exige o header `X-API-Key`.
# IMPORTANTE: ao ativar, o dashboard estático (apps/dashboard/static) também
# precisa enviar o header X-API-Key nas chamadas.
API_KEY=
# Máximo de chamadas por IP por minuto na rota /api/hermes (consome LLM).
RATE_LIMIT_PER_MIN=10

# ── Paths ──
DASHBOARD_PATH=./apps/dashboard/static
HERMES_CLI=${HOME}/.local/bin/hermes

# ── Hermes AI ──
HERMES_TIMEOUT=120

# ── MCP Memory Server (apps/mcp-memory) ──
# Endpoint de persistência LTM no servidor central
MEMORY_API_URL=http://100.64.117.78:5050
# Chave para o header X-API-Key nas chamadas à API (opcional, espelha API_KEY)
MEMORY_API_KEY=

# ── Camada de Documentos (ChromaDB) ──
# Endpoint SSE do chromadb-mcp (mesmo host do memory server)
CHROMA_MCP_URL=http://localhost:8765/mcp
# Timeout de conexão SSE (segundos)
CHROMA_SSE_TIMEOUT=10

# ── Sumarização local ──
# Endpoint e modelo do sumarizador (llama.cpp Qwen3-1.7B)
SUMMARIZER_API=http://localhost:11435/v1/chat/completions
SUMMARIZER_MODEL=Qwen3-1.7B
