# ?? Core (Servidor API Central :5050) ??
APP_NAME=EstudioHC Central API
DEBUG=false
API_PORT=5050

# ?? Database ??
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///${HOME}/Apps/EstudioHC-Memory-Suite/data/estudiohc.db
# PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/estudiohc

# ?? CORS ??
CORS_ORIGINS=["*"]

# ?? Auth ??
# API key mestre. Configurado = toda rota protegida exige o header `X-API-Key`.
API_KEY=
# M?ximo de chamadas por IP por minuto na rota /api/hermes (consome LLM).
RATE_LIMIT_PER_MIN=10

# ?? Paths ??
DASHBOARD_PATH=./apps/dashboard/static
HERMES_CLI=${HOME}/.local/bin/hermes
HERMES_TIMEOUT=120

# ?? MCP Memory Server (apps/mcp-memory :5051) ??
MEMORY_API_URL=https://127.0.0.1:5050
MEMORY_API_KEY=
AGENT_NAME=opencode

# ?? Camada de Documentos (ChromaDB :8765) ??
CHROMA_MCP_URL=http://localhost:8765/mcp
CHROMA_SSE_TIMEOUT=10

# ?? Sumariza??o local (opcional) ??
SUMMARIZER_API=http://localhost:11435/v1/chat/completions
SUMMARIZER_MODEL=Qwen3-1.7B

# ?? Esta??o de Trabalho / Obsidian Collector v2.0 (~/.estudiohc/.env) ??
ESTUDIOHC_HUB=hub.estudiohc
ESTUDIOHC_API_URL=https://hub.estudiohc:5050
ESTUDIOHC_MCP_URL=http://hub.estudiohc:5051
ESTUDIOHC_FALLBACK_API_URL=https://100.107.208.50:5050
ESTUDIOHC_FALLBACK_MCP_URL=http://100.107.208.50:5051
ESTUDIOHC_API_KEY=
ESTUDIOHC_STATION_NAME=WIN-X99
OBSIDIAN_VAULT=C:\Users\helcio\Documents\Notas
COLLECTOR_INTERVAL=5
COLLECTOR_DEBOUNCE_SEC=15
