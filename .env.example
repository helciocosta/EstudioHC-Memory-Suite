# ── Core ──
APP_NAME=EstudioHC Central API
DEBUG=false
API_PORT=5050

# ── Database ──
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///${HOME}/Apps/EstudioHC-Memory-Suite/data/estudiohc.db
# PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/estudiohc

# ── CORS ──
CORS_ORIGINS=["*"]

# ── Paths ──
DASHBOARD_PATH=./apps/dashboard/static
HERMES_CLI=${HOME}/.local/bin/hermes

# ── Hermes AI ──
HERMES_TIMEOUT=120